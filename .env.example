# Docker Compose settings only. Native backend settings belong in backend/.env.
# Generate a URL-safe password, e.g. python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=replace-with-a-generated-url-safe-password
# Generate an independent signing key of at least 32 characters.
JWT_SECRET_KEY=replace-with-an-independently-generated-signing-key
