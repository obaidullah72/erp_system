ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://erp:replace-with-local-password@localhost:5432/erp
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT utilities stay disabled until a key is configured. No login route in Phase 1.
# JWT_SECRET_KEY=
JWT_ISSUER=erp-api
JWT_AUDIENCE=erp-web
ACCESS_TOKEN_MINUTES=15
